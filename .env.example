# Groq API Key for AI question generation
# Get your free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_api_key_here

# MongoDB Atlas connection string for backend persistence
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/examcraft?retryWrites=true&w=majority

# JWT secret used by the backend to issue session tokens
JWT_SECRET=your_long_random_jwt_secret_here

# Registration invite code required for new accounts
REGISTRATION_INVITE_CODE=Scholar2026
